DATABASE_URL=postgres://ondeck:ondeck@localhost:5432/ondeck
PORT=8787

# Optional. Without these, the Mac app still gets banners over the live stream
# while it is open. Remote push needs an APNs key from the Apple Developer account.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.DanielEskandar.OnDeck
APNS_KEY_PATH=
APNS_PRODUCTION=false
